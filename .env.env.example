# Shared test/staging stack. Copy to a private .env.env and replace all passwords.
POSTGRES_PASSWORD=replace-with-random-password
RABBITMQ_PASSWORD=replace-with-another-random-password
# Keep environment-stage image tags separate from the local development images.
HOTKEY_BACKEND_IMAGE=hotkey-backend:env
HOTKEY_WEB_IMAGE=hotkey-web:env
# Percent-encode URL passwords. Keep these credentials in sync with the values above.
HOTKEY_DATABASE_URL=postgresql+psycopg://hotkey:replace-with-random-password@postgres:5432/hotkey
HOTKEY_BROKER_URL=amqp://hotkey:replace-with-another-random-password@rabbitmq:5672/hotkey
HOTKEY_ALLOWED_ORIGINS=["https://staging.hotkey.example.com"]
HOTKEY_WEB_PORT=8010
# Existing private MinIO only. Set all four values together when enabled.
HOTKEY_S3_ENDPOINT=minio.internal:9000
HOTKEY_S3_ACCESS_KEY=replace-with-private-access-key
HOTKEY_S3_SECRET_KEY=replace-with-private-secret-key
HOTKEY_S3_BUCKET=hotkey-evidence-staging
HOTKEY_S3_SECURE=true
HOTKEY_SOURCE_RIGHTS_ALLOWED=[]
HOTKEY_SOURCE_PIPELINES_CONNECTED=[]
# Existing self-hosted Ollama origin; leave empty until enabled.
HOTKEY_EMBEDDING_BASE_URL=
HOTKEY_EMBEDDING_MODEL=qwen3-embedding:latest
HOTKEY_EMBEDDING_MODEL_DIGEST=
HOTKEY_EMBEDDING_DIMENSIONS=1024
HOTKEY_EMBEDDING_TIMEOUT_SECONDS=15
