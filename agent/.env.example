# 仅用于 Go Worker 到 Python Agent 的内部服务认证，至少 32 字节。
HOTKEY_AGENT_AUTH_TOKEN=

# 默认安全基线为 deterministic；真实模型只能用于 003 受信 Golden/Shadow 验收，不会自动进入 Live。
HOTKEY_AGENT_RUNTIME=deterministic
HOTKEY_AGENT_MAX_REQUEST_BYTES=262144
HOTKEY_AGENT_MAX_CONCURRENCY=2

# 受信真实模型候选配置；端点必须使用 HTTPS，模型实际返回版本必须与 MODEL_VERSION 一致。
# HOTKEY_AGENT_RUNTIME=openai_compatible
HOTKEY_AGENT_MODEL_BASE_URL=
HOTKEY_AGENT_MODEL_API_KEY=
HOTKEY_AGENT_MODEL_NAME=
HOTKEY_AGENT_MODEL_VERSION=
HOTKEY_AGENT_MODEL_TIMEOUT_SECONDS=30
HOTKEY_AGENT_MODEL_MAX_RESPONSE_BYTES=1048576
HOTKEY_AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
