{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atomic-claim-evidence-input-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_version", "event_key", "document_version_id", "plaintext_sha256", "body", "body_truncated"],
  "properties": {
    "event_id": {"type": "integer", "minimum": 1},
    "event_version": {"type": "integer", "minimum": 1},
    "event_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "document_version_id": {"type": "integer", "minimum": 1},
    "plaintext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body": {"type": "string", "minLength": 1, "maxLength": 100000},
    "body_truncated": {"type": "boolean"}
  }
}
