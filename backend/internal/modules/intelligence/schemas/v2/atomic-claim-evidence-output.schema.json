{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atomic-claim-evidence-output-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subject", "predicate", "object", "relation", "exact_quote", "relation_score", "qualifiers"],
        "properties": {
          "subject": {"type": "string", "minLength": 1, "maxLength": 512},
          "predicate": {"type": "string", "minLength": 1, "maxLength": 256},
          "object": {"type": "string", "minLength": 1, "maxLength": 2000},
          "relation": {"type": "string", "enum": ["asserts", "attributes_to", "mentions", "contradicts", "corrects", "withdraws", "unknown"]},
          "exact_quote": {"type": "string", "minLength": 1, "maxLength": 4096},
          "relation_score": {"type": "number", "minimum": 0, "maximum": 1},
          "qualifiers": {
            "type": "array", "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "value"],
              "properties": {
                "key": {"type": "string", "minLength": 1, "maxLength": 64},
                "value": {"type": "string", "minLength": 1, "maxLength": 512}
              }
            }
          }
        }
      }
    }
  }
}
