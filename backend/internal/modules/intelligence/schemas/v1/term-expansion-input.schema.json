{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "term-expansion-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "clauses", "entities", "examples", "existing_candidates", "output_languages"],
  "properties": {
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "clauses": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "field", "value"],
        "properties": {
          "operator": { "type": "string", "enum": ["must", "should", "must_not"] },
          "field": { "type": "string", "enum": ["term", "phrase", "action", "location", "language", "region", "source", "time_window"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "display_name", "aliases", "ambiguity_note"],
        "properties": {
          "canonical_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "ambiguity_note": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "enum": ["positive", "negative"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "existing_candidates": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "output_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["zh", "en", "und"] }
    }
  }
}
