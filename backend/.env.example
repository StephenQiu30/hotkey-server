# HotKey Server 日常环境模板
#
# 复制为 .env 后即可启动：cp .env.example .env
# 只需填写“必须填写”的空值；未列出的配置均使用程序默认值。
# 请勿把真实密钥、Token 或 .env 文件提交到仓库（见 AGENTS.md）。

# ===== 运行环境与监听 =====

# 运行环境：development / production。
# 设为 production 后，服务会在 .env 基础上叠加读取 .env.prod，并关闭 Swagger UI 与 OpenAPI 路由。
# 默认：development。
# HOTKEY_ENV=development

# 运行角色：all / api / worker。
# all    = 同一进程提供 HTTP API 并执行采集、AI、报告与投递任务（本地体验与小型部署）。
# api    = 只提供 HTTP API。
# worker = 只执行后台任务。
# 默认：all。
# HOTKEY_ROLE=all

# HTTP 监听地址（host:port 格式）。默认 :8080，即监听所有网卡 8080 端口。
# 本机仅开发时可改为 127.0.0.1:8080 以限制只对本机开放。
# HOTKEY_HTTP_ADDR=:8080

# ===== PostgreSQL（业务事实源） =====
# 同时保存业务事实数据与 River 任务数据。直接运行 Server 时使用；
# Docker Compose 会自动改为容器内地址。

HOTKEY_DATABASE_URL=postgres://hotkey:hotkey@localhost:5432/hotkey?sslmode=disable

# ===== MinIO（原始证据存储） =====
# 保存原始响应、正文、截图和附件。EvidenceStore 运行时需要以下四项完整匹配实际 MinIO 服务。

HOTKEY_MINIO_ENDPOINT=localhost:9000
HOTKEY_MINIO_ACCESS_KEY=hotkey
HOTKEY_MINIO_SECRET_KEY=change-me
HOTKEY_MINIO_BUCKET=hotkey-evidence

# MinIO 是否使用 HTTPS（TLS）。本地无需加密时保持 false；生产必须 true 并让反向代理终结 TLS。
# HOTKEY_MINIO_USE_SSL=false

# ===== Redis（短期状态） =====
# 只保存验证码、限流和短期票据，不保存已经确认的身份认证事实或业务数据。

HOTKEY_REDIS_URL=redis://127.0.0.1:6379/0

# ===== 身份认证与签名密钥 =====

# 必须填写：JWT 访问令牌签名密钥。至少 32 字节，与 HMAC 密钥必须不同。
# 推荐生成命令：openssl rand -hex 32
HOTKEY_JWT_SECRET=

# 必须填写：注册/密码重置等一次性验证码的 HMAC 签名密钥。至少 32 字节，与 JWT 密钥必须不同。
# 推荐生成命令：openssl rand -hex 32
HOTKEY_VERIFICATION_HMAC_SECRET=

# JWT 签发方（iss）与受众（aud）。一般保持默认即可，多环境隔离时才需要区分。
# HOTKEY_JWT_ISSUER=hotkey
# HOTKEY_JWT_AUDIENCE=hotkey-web

# 刷新会话 Cookie 是否仅允许 HTTPS 传输。本地开发用 false；生产必须 true。
# 浏览器访问站点若未配置 HTTPS，设 true 会导致刷新会话无法携带，登录后很快失效。
# HOTKEY_REFRESH_COOKIE_SECURE=false

# ===== CORS =====

# 必须填写：允许浏览器携带凭据访问的精确 Origin，多个地址用英文逗号分隔，禁止使用 *。
HOTKEY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== 本地知识库 Vault =====
# 进程只能写入此目录及其子目录。默认 ./var/vault 相对于进程工作目录解析；
# 推荐填写绝对路径，避免因启动目录不同而写入错误位置。

# HOTKEY_VAULT_PATH=./var/vault

# ===== SMTP（注册验证 / 密码重置邮件） =====

# 可选：启用 SMTP 后才需要取消注释并填写。注册验证码和密码重置邮件依赖此配置。
# 请填写邮件服务商生成的 SMTP 授权码，不要填写或提交网页登录密码。
# HOTKEY_SMTP_ENABLED=true
# HOTKEY_SMTP_HOST=smtp.163.com
# HOTKEY_SMTP_PORT=465
# HOTKEY_SMTP_TLS_MODE=tls
# HOTKEY_SMTP_USERNAME=your-account@163.com
# HOTKEY_SMTP_PASSWORD=your-smtp-authorization-code
# HOTKEY_SMTP_FROM_EMAIL=your-account@163.com
# HOTKEY_SMTP_FROM_NAME=HotKey

# ===== 来源连接器（可选，按需启用） =====

# 只有启用对应来源时才填写；凭据不得提交明文。
# HOTKEY_X_BEARER_TOKEN=
# HOTKEY_YOUTUBE_API_KEY=
# HOTKEY_REDDIT_CLIENT_ID=
# HOTKEY_REDDIT_CLIENT_SECRET=
# HOTKEY_BILIBILI_WEBHOOK_SECRET=

# ===== AI Provider（可选，按需启用） =====
# 未配置任何 Provider 时，变化检测、Radar 与告警仍然运行；AI 摘要会明确降级为基于证据的结果。

# HOTKEY_OPENAI_API_KEY=
# HOTKEY_DEEPSEEK_API_KEY=
# HOTKEY_OLLAMA_ENABLED=false
# HOTKEY_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 以下 ONNX Embedding 配置为可选的本地 Embedding 适配器，一般无需配置。
# HOTKEY_ONNX_RUNTIME_LIBRARY=
# HOTKEY_ONNX_MODEL_PATH=
# HOTKEY_ONNX_TOKENIZER_PATH=
# HOTKEY_ONNX_MANIFEST_PATH=

# ===== 网络与可观测（可选） =====

# 来源抓取的 DoH 解析地址；普通部署无需配置。
# HOTKEY_SOURCE_DOH_URL=https://dns.google/dns-query
# OpenTelemetry 链路追踪导出端点；未配置则不上报。
# HOTKEY_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces

# ===== 站内通知（可选） =====

# 站内通知轮询间隔、SSE 心跳间隔与单进程连接上限。
# HOTKEY_NOTIFICATION_POLL_INTERVAL=1s
# HOTKEY_NOTIFICATION_HEARTBEAT_INTERVAL=10s
# HOTKEY_NOTIFICATION_MAX_CONNECTIONS=100

# ===== Worker 与超时（可选，一般用默认值） =====

# Worker 轮询间隔、并发数、任务租约超时与定时任务间隔。
# HOTKEY_WORKER_POLL_INTERVAL=1s
# HOTKEY_WORKER_CONCURRENCY=1
# HOTKEY_WORKER_LEASE_TIMEOUT=5m
# HOTKEY_CRON_INTERVAL=1m
# HTTP 请求与优雅关闭超时。
# HOTKEY_REQUEST_TIMEOUT=15s
# HOTKEY_SHUTDOWN_TIMEOUT=15s

# Docker Compose 的宿主机端口覆盖已统一放在仓库根目录 `.env.example`。
