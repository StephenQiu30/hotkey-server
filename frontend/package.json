{
  "name": "hotkey-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../docs/openapi/openapi.json -o src/api.generated.ts",
    "check:contract": "node scripts/check-contract.mjs",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts playwright.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
