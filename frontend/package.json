{
  "name": "hotkey-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8080",
    "start": "next start --hostname 0.0.0.0 --port 8080",
    "generate": "openapi2ts",
    "check:contract": "npm run generate && git diff --exit-code -- src/api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" next.config.ts postcss.config.mjs eslint.config.mjs components.json openapi2ts.config.ts playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@umijs/openapi": "^1.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0"
  }
}
