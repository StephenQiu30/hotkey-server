{
  "name": "hotkey-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi2ts",
    "check:contract": "node scripts/check-contract.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node scripts/check-boundaries.test.mjs",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts openapi2ts.config.ts playwright.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@umijs/openapi": "^1.14.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
