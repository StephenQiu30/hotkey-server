# HotKey Server 生产环境模板
# 复制为 .env.prod，填写下面 8 个空值，然后使用 README 中的生产 Compose 命令启动。
# Compose 已固定 production、all 角色、内部服务地址、安全 Cookie、超时和 Worker 默认值，无需重复填写。

# 可选：生产容器固定名称前缀，默认 hotkey-prod。
# 同一主机部署多套实例时必须为每套设置不同前缀。
# HOTKEY_CONTAINER_PREFIX=hotkey-prod

# 1. PostgreSQL 密码
# 必须填写 URL 安全的随机值；推荐：openssl rand -hex 32。
# Compose 会用它同时配置 PostgreSQL 和 Server DSN，无需再手写 HOTKEY_DATABASE_URL。
POSTGRES_PASSWORD=

# 2–3. MinIO 管理账号与密码
# Compose 会把同一组值映射给 Server，无需重复填写 HOTKEY_MINIO_ACCESS_KEY / SECRET_KEY。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 4–5. 身份认证密钥
# 必须是两个不同的随机值，每个至少 32 字节；推荐分别执行两次：openssl rand -hex 32。
HOTKEY_JWT_SECRET=
HOTKEY_VERIFICATION_HMAC_SECRET=

# 6. 来源凭据主密钥
# 用于登录后的来源管理页认证加密第三方 Token；推荐：openssl rand -base64 32。
# 必须与数据库备份分开保管，不得复用 JWT/HMAC 密钥。
HOTKEY_SOURCE_CREDENTIAL_MASTER_KEY=

# 7. Python Agent 内部服务认证密钥
# 仅用于 Go Worker 调用 Agent，必须与 JWT/HMAC/来源主密钥不同且至少 32 字节。
HOTKEY_AGENT_AUTH_TOKEN=

# 8. Web 生产地址
# 填写完整 HTTPS Origin，不带路径；多个地址用英文逗号分隔，禁止使用 *。
HOTKEY_CORS_ALLOWED_ORIGINS=

# 可选：自定义 MinIO Bucket；不配置时使用 hotkey-evidence。
# HOTKEY_MINIO_BUCKET=hotkey-evidence

# 可选：覆盖生产环境对外端口。
# HOTKEY_HTTP_PORT=8866
# WEB_PORT=8010

# 可选：启用 注册验证码 / 密码重置邮件 后才需要取消注释并填写。
# TLS 模式可选 tls（通常用 465）或 starttls（通常用 587）。
# HOTKEY_SMTP_ENABLED=true
# HOTKEY_SMTP_HOST=smtp.163.com
# HOTKEY_SMTP_PORT=465
# HOTKEY_SMTP_TLS_MODE=tls
# HOTKEY_SMTP_USERNAME=
# HOTKEY_SMTP_PASSWORD=
# HOTKEY_SMTP_FROM_EMAIL=
# HOTKEY_SMTP_FROM_NAME=HotKey

# 可选：只有继续使用旧 env:NAME 来源或启用 AI Provider 时才填写。
# HOTKEY_X_BEARER_TOKEN=
# HOTKEY_YOUTUBE_API_KEY=
# HOTKEY_REDDIT_CLIENT_ID=
# HOTKEY_REDDIT_CLIENT_SECRET=
# HOTKEY_OPENAI_API_KEY=
# HOTKEY_DEEPSEEK_API_KEY=
# HOTKEY_OLLAMA_ENABLED=true
# HOTKEY_OLLAMA_BASE_URL=http://host.docker.internal:11434
