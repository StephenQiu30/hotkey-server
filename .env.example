# 项目只使用两个配置文件：默认环境使用 .env，生产环境使用 .env.prod 覆盖配置。
# 启动时设置 HOTKEY_ENV=production 即可加载 .env.prod。
# 运行环境可选值：development、testing、production
HOTKEY_ENV=development
HOTKEY_ROLE=all
HOTKEY_HTTP_ADDR=:8080
HOTKEY_REQUEST_TIMEOUT=15s
HOTKEY_SHUTDOWN_TIMEOUT=15s

# Worker 与调度器运行配置；时间值使用 Go duration 语法，例如 1s、5m。
HOTKEY_WORKER_POLL_INTERVAL=1s
HOTKEY_WORKER_CONCURRENCY=1
HOTKEY_WORKER_LEASE_TIMEOUT=5m
HOTKEY_CRON_INTERVAL=1m

# 可选：来源连接器使用的 RFC 8484 DNS-over-HTTPS 解析地址。
# 当本地透明代理返回 198.18.0.0/15 网段的 Fake-IP 时需要配置。
HOTKEY_SOURCE_DOH_URL=

# 可选：OTLP/HTTP 链路追踪上报地址，例如 http://localhost:4318/v1/traces。
HOTKEY_OTLP_HTTP_ENDPOINT=

# PostgreSQL 同时存储业务事实数据和 River 任务数据。
HOTKEY_DATABASE_URL=postgres://hotkey:hotkey@localhost:5432/hotkey?sslmode=disable

# MinIO 用于存储原始响应、正文、截图和附件。
# EvidenceStore 运行时需要完整配置以下四项；仅执行数据库命令时不需要。
# 真实凭据只能保存在本地 .env 或 .env.prod 中，禁止记录到日志或通过接口返回。
HOTKEY_MINIO_ENDPOINT=localhost:9000
HOTKEY_MINIO_ACCESS_KEY=hotkey
HOTKEY_MINIO_SECRET_KEY=change-me
HOTKEY_MINIO_BUCKET=hotkey-evidence
HOTKEY_MINIO_USE_SSL=false

# 本地 Obsidian Vault 根目录；进程只能写入此目录及其子目录。
HOTKEY_VAULT_PATH=./var/vault

# 身份认证配置：所有提供身份接口的环境都必须填写独立、随机且不少于 32 字节的密钥。
# 示例文件必须保持为空，真实值只能写入本地 .env、.env.prod 或进程环境变量。
HOTKEY_JWT_SECRET=
HOTKEY_JWT_ISSUER=hotkey
HOTKEY_JWT_AUDIENCE=hotkey-web
# 身份接口运行时必填：设置至少 32 字节的独立密钥，禁止提交到仓库。
HOTKEY_VERIFICATION_HMAC_SECRET=
# Redis 只保存短期验证码和限流状态，不保存已经确认的身份认证事实。
HOTKEY_REDIS_URL=redis://127.0.0.1:6379/0
# 浏览器携带凭据访问时必须列出精确 Origin，禁止使用 *。
HOTKEY_CORS_ALLOWED_ORIGINS=http://localhost:3000
HOTKEY_REFRESH_COOKIE_SECURE=false

# 可选：163 SMTP 邮件发送配置；真实凭据不得提交到仓库。
HOTKEY_SMTP_ENABLED=false
HOTKEY_SMTP_HOST=smtp.163.com
HOTKEY_SMTP_PORT=465
HOTKEY_SMTP_TLS_MODE=tls
HOTKEY_SMTP_USERNAME=
HOTKEY_SMTP_PASSWORD=
HOTKEY_SMTP_FROM_EMAIL=
HOTKEY_SMTP_FROM_NAME=HotKey

# 仅 `hotkey user bootstrap-admin` 命令读取以下配置，而且只允许在用户表为空时执行。
HOTKEY_BOOTSTRAP_ADMIN_EMAIL=
HOTKEY_BOOTSTRAP_ADMIN_PASSWORD=

# 可选：按实际启用的数据来源填写对应凭据。
HOTKEY_X_BEARER_TOKEN=
HOTKEY_YOUTUBE_API_KEY=
HOTKEY_REDDIT_CLIENT_ID=
HOTKEY_REDDIT_CLIENT_SECRET=

# AI 模型配置需要显式启用。OpenAI 密钥只用于解析固定的
# env:OPENAI_API_KEY 凭据引用。ONNX 必须完整配置以下四个路径，
# 并使用 -tags=onnx 且 CGO_ENABLED=1 构建，否则不可用。
HOTKEY_OPENAI_API_KEY=
HOTKEY_DEEPSEEK_API_KEY=
HOTKEY_OLLAMA_ENABLED=false
HOTKEY_OLLAMA_BASE_URL=http://127.0.0.1:11434
HOTKEY_ONNX_RUNTIME_LIBRARY=
HOTKEY_ONNX_MODEL_PATH=
HOTKEY_ONNX_TOKENIZER_PATH=
HOTKEY_ONNX_MANIFEST_PATH=
