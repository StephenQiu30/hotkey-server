# HotKey Server 日常环境模板
# 复制为 .env 后，只需填写“必须填写”的空值。未列出的配置均使用程序默认值。

# PostgreSQL：直接运行 Server 时使用；Docker Compose 会自动改为容器内地址。
HOTKEY_DATABASE_URL=postgres://hotkey:hotkey@localhost:5432/hotkey?sslmode=disable

# MinIO：保存原始响应、正文、截图和附件。
HOTKEY_MINIO_ENDPOINT=localhost:9000
HOTKEY_MINIO_ACCESS_KEY=hotkey
HOTKEY_MINIO_SECRET_KEY=change-me
HOTKEY_MINIO_BUCKET=hotkey-evidence

# Redis：只保存验证码、限流和短期票据，不保存业务事实。
HOTKEY_REDIS_URL=redis://127.0.0.1:6379/0

# 必须填写：分别生成两个不同的随机值，每个至少 32 字节。
# 推荐命令：openssl rand -hex 32
HOTKEY_JWT_SECRET=
HOTKEY_VERIFICATION_HMAC_SECRET=

# 必须填写：允许浏览器携带凭据访问的精确 Origin；多个地址用英文逗号分隔，禁止使用 *。
HOTKEY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 可选：Obsidian Vault 路径；不配置时使用 ./var/vault。
# HOTKEY_VAULT_PATH=./var/vault

# 可选：启用 SMTP 后才需要取消注释并填写，用于注册验证和密码重置。
# HOTKEY_SMTP_ENABLED=true
# HOTKEY_SMTP_HOST=smtp.163.com
# HOTKEY_SMTP_PORT=465
# HOTKEY_SMTP_TLS_MODE=tls
# HOTKEY_SMTP_USERNAME=your-account@163.com
# HOTKEY_SMTP_PASSWORD=your-smtp-authorization-code
# HOTKEY_SMTP_FROM_EMAIL=your-account@163.com
# HOTKEY_SMTP_FROM_NAME=HotKey

# 可选：只有启用对应来源时才填写。
# HOTKEY_X_BEARER_TOKEN=
# HOTKEY_YOUTUBE_API_KEY=
# HOTKEY_REDDIT_CLIENT_ID=
# HOTKEY_REDDIT_CLIENT_SECRET=

# 可选：只有启用对应 AI Provider 时才填写。
# HOTKEY_OPENAI_API_KEY=
# HOTKEY_DEEPSEEK_API_KEY=
# HOTKEY_OLLAMA_ENABLED=true
# HOTKEY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 可选：网络和链路追踪；普通部署无需配置。
# HOTKEY_SOURCE_DOH_URL=https://dns.google/dns-query
# HOTKEY_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces

# 可选：docker-compose-env.yml 的宿主机端口覆盖；默认值如下。
# HOTKEY_HTTP_PORT=8080
# HOTKEY_POSTGRES_PORT=5432
# HOTKEY_REDIS_PORT=6379
# HOTKEY_MINIO_PORT=9000
# HOTKEY_MINIO_CONSOLE_PORT=9001
