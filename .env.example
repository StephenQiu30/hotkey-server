# Root Docker Compose configuration. Copy this file to .env for local use.
# Use an URL-safe value because Compose also embeds it in HOTKEY_DATABASE_URL.
HOTKEY_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE

# Generate a unique value with at least 32 characters before first-owner setup.
# Remove it after initialization. There is deliberately no usable default.
HOTKEY_BOOTSTRAP_TOKEN=
HOTKEY_SOURCE_CREDENTIALS={}

# Bind application ports to localhost by default.
HOTKEY_API_PORT=8867
HOTKEY_WEB_PORT=3000

# Optional isolated browser runtime. The dedicated proxy initially allows only example.com;
# keep platform collection disabled until its domain, budget, and WS gates pass.
HOTKEY_BROWSER_ENABLED=false
# Generate a private 48-character hex token; use the same URL for browser and worker.
# Example shape: ws://browser:3000/ws/<48 hex chars> (never commit the actual value).
HOTKEY_BROWSER_WS_URL=
