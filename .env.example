# Local Compose binds to loopback. No default owner account is created.
HOTKEY_WEB_PORT=8010
HOTKEY_BACKEND_PORT=8867
HOTKEY_DB_PORT=15435
HOTKEY_AMQP_PORT=15673
# Existing MinIO only. Set all four connection values together; do not create a local service.
# HOTKEY_S3_ENDPOINT=minio.internal:9000
# HOTKEY_S3_ACCESS_KEY=replace-with-private-access-key
# HOTKEY_S3_SECRET_KEY=replace-with-private-secret-key
# HOTKEY_S3_BUCKET=hotkey-evidence-dev
# HOTKEY_S3_SECURE=true
# Exact source.operation JSON arrays. Keep empty until rights and persistent POC both pass.
HOTKEY_SOURCE_RIGHTS_ALLOWED=[]
HOTKEY_SOURCE_PIPELINES_CONNECTED=[]
# Existing self-hosted Ollama origin reachable by backend containers. Leave blank until enabled.
# HOTKEY_EMBEDDING_BASE_URL=http://ollama.internal:11434
# HOTKEY_EMBEDDING_MODEL=qwen3-embedding:latest
# HOTKEY_EMBEDDING_MODEL_DIGEST=replace-with-64-character-model-sha256
# HOTKEY_EMBEDDING_DIMENSIONS=1024
# HOTKEY_EMBEDDING_TIMEOUT_SECONDS=15
