# HotKey 根级 Docker Compose 部署环境模板
#
# 复制为 .env 后供 `docker compose -f docker-compose.yml` 使用。
# 本机开发不读取本文件，也不使用 Compose 基础设施；请直接配置 backend/.env。
# 后端容器运行时配置仍从 backend/.env 读取；本文件只覆盖 Compose 编排参数。
# 生产环境模板见 .env.prod.example（配合 docker-compose-prod.yml）。

# 容器固定名称前缀；默认生成 hotkey-postgres、hotkey-redis、hotkey-minio、
# hotkey-minio-init、hotkey-db-init、hotkey-api 和 hotkey-web，不使用 -1 后缀。
# 同一主机部署多套实例时必须为每套设置不同前缀。
# HOTKEY_CONTAINER_PREFIX=hotkey

# ===== 对外端口覆盖 =====
# Compose 默认将后端映射到 8080、前端映射到 3000；端口被占用时才需要覆盖。

# 后端 HTTP 端口映射到宿主机端口；默认 8866。
# HOTKEY_HTTP_PORT=8866

# Web 前端端口映射到宿主机端口；默认 8123。
# WEB_PORT=8123

# ===== 基础设施账号与密钥（日常开发可选） =====
# 以下变量均有默认值（daily 环境），日常开发通常无需覆盖；
# 生产环境强制在 .env.prod 中填写（见 .env.prod.example）。

# PostgreSQL 业务库账号密码；默认 hotkey：hotkey。
# POSTGRES_PASSWORD=hotkey

# MinIO 管理账号与密码；默认 hotkey：change-me。
# MINIO_ROOT_USER=hotkey
# MINIO_ROOT_PASSWORD=change-me

# 后端允许浏览器携带凭据访问的精确 Origin；默认 http://localhost:8123。
# HOTKEY_CORS_ALLOWED_ORIGINS=http://localhost:8123

# MinIO 证据 Bucket 名称；默认 hotkey-evidence。
# HOTKEY_MINIO_BUCKET=hotkey-evidence

# ===== 通知参数覆盖（可选） =====
# Compose 已提供与程序默认一致的值，一般无需覆盖。

# HOTKEY_NOTIFICATION_POLL_INTERVAL=1s
# HOTKEY_NOTIFICATION_HEARTBEAT_INTERVAL=10s
# HOTKEY_NOTIFICATION_MAX_CONNECTIONS=100
# HOTKEY_NOTIFICATION_WEB_ORIGIN=http://127.0.0.1:8123
# HOTKEY_WEB_PUSH_VAPID_PUBLIC_KEY=
# HOTKEY_WEB_PUSH_VAPID_PRIVATE_KEY=
# HOTKEY_WEB_PUSH_VAPID_SUBJECT=mailto:security@example.com
# HOTKEY_WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
